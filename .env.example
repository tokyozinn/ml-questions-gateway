# === Mercado Livre (obrigatório) ===
# Ação manual: criar app no DevCenter ML
# https://developers.mercadolivre.com.br/pt_br/crie-uma-aplicacao-no-mercado-livre
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:8000/auth/callback

# === Gateway (obrigatório) ===
GATEWAY_API_KEY=change-me-in-production
GATEWAY_PUBLIC_URL=http://localhost:8000
APP_NAME=ML Questions Gateway
HOST=0.0.0.0
PORT=8000

# === Feature flags ===
FEATURE_WHATSAPP_ENABLED=false
FEATURE_AUTO_ANSWER_ENABLED=true

# === IA (obrigatório no MVP — ADR-BIZ-001) ===
# Ação manual: fornecer chave OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PRODUCT_CONTEXT_CACHE_TTL=3600

# === Persistência ===
DATABASE_URL=file:./data/bot.db

