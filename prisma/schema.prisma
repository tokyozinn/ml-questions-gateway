generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  pending
  active
  suspended
  disconnected
}

enum BillingProvider {
  stripe
  hotmart
}

model Tenant {
  id                  String          @id @default(uuid())
  name                String
  slug                String          @unique
  mlUserId            Int?            @unique @map("ml_user_id")
  status              TenantStatus    @default(pending)
  autoAnswerEnabled   Boolean         @default(true) @map("auto_answer_enabled")
  whatsappPhone       String?         @map("whatsapp_phone")
  billingEmail        String?         @map("billing_email")
  billingProvider     BillingProvider? @map("billing_provider")
  billingExternalId   String?         @map("billing_external_id")
  connectedAt         DateTime?       @map("connected_at")
  createdAt           DateTime        @default(now()) @map("created_at")

  @@map("tenants")
}

enum EscalationReason {
  no_context
  low_confidence
  item_fetch_failed
  sensitive_category
}

model ProcessedQuestion {
  questionId   Int      @id @map("question_id")
  sellerId     Int      @map("seller_id")
  itemId       String   @map("item_id")
  questionText String   @map("question_text")
  answerText   String   @map("answer_text")
  processedAt  DateTime @default(now()) @map("processed_at")

  @@map("processed_questions")
}

model EscalatedQuestion {
  questionId             Int              @id @map("question_id")
  tenantId               String           @map("tenant_id")
  itemId                 String           @map("item_id")
  questionText           String           @map("question_text")
  reason                 EscalationReason
  productContextSnapshot String?          @map("product_context_snapshot")
  escalatedAt            DateTime         @default(now()) @map("escalated_at")

  @@map("escalated_questions")
}

model OAuthToken {
  userId       Int      @id @map("user_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    Int      @map("expires_at")

  @@map("oauth_tokens")
}
